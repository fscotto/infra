[Unit]
Description=Atlas private Paperless Ollama
RequiresMountsFor={{ atlas_paperless_root }}/ollama

[Container]
ContainerName=atlas-paperless-ollama
Image={{ atlas_paperless_ollama_image }}
UserNS=keep-id:uid={{ atlas_admin_uid }},gid={{ atlas_admin_gid }}
User={{ atlas_admin_uid }}:{{ atlas_admin_gid }}
Network=atlas-paperless.network
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_MODELS=/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=2m
Environment=OLLAMA_NO_CLOUD=true
Volume={{ atlas_paperless_root }}/ollama:/models:Z
PodmanArgs=--memory=3g
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
