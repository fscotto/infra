# Bootstrap monouso per Fedora CoreOS su Aegis.
# Sostituire le chiavi SSH prima di generare Ignition con butane --strict.
variant: fcos
version: 1.6.0
passwd:
  users:
    - name: pi
      ssh_authorized_keys:
        - "ssh-ed25519 CHANGEME_AEGIS_SSH_PUBLIC_KEY"
storage:
  disks:
    - device: /dev/mmcblk0
      wipe_table: false
      partitions:
        - label: aegis-data
          number: 5
          size_mib: 0
  filesystems:
    - device: /dev/disk/by-partlabel/aegis-data
      format: btrfs
      label: aegis-data
      wipe_filesystem: false
      mount:
        path: /
        options:
          - compress=zstd
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
          aegis
