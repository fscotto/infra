profile solo {
  output DP-1 disable
  output DP-2 disable
  output HDMI-A-1 disable
  output HDMI-A-2 disable
  output eDP-1 enable mode 1920x1080 position 0,0
}

profile dual {
  output DP-2 disable
  output HDMI-A-1 disable
  output HDMI-A-2 disable
  output eDP-1 enable mode 1920x1080 position 0,0
  output DP-1 enable mode 3440x1440@100Hz position 1920,0
}
