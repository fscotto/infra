[Unit]
Description=Atlas Paperless PostgreSQL
RequiresMountsFor={{ atlas_paperless_root }}/database

[Container]
ContainerName=atlas-paperless-db
Image={{ atlas_paperless_postgres_image }}
Network=atlas-paperless.network
NetworkAlias=atlas-paperless-db
Environment=POSTGRES_DB=paperless
Environment=POSTGRES_USER=paperless
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password
Volume={{ atlas_paperless_private_dir }}/postgres-password:/run/secrets/postgres-password:ro,z
Volume={{ atlas_paperless_root }}/database:/var/lib/postgresql/data:Z
PodmanArgs=--memory=1g
HealthCmd=pg_isready -U paperless -d paperless
HealthInterval=30s
HealthStartPeriod=60s
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=default.target
