# Managed by Ansible. Never expose this file: it contains the RPC secret.
dir=/downloads
input-file=/config/session
save-session=/config/session
save-session-interval=30
auto-save-interval=30
continue=true
allow-overwrite=false
auto-file-renaming=false
max-concurrent-downloads=1
max-connection-per-server=1
split=1
max-tries=20
retry-wait=10
connect-timeout=30
timeout=60
check-certificate=true
file-allocation=none
umask=007
enable-rpc=true
rpc-listen-all=true
rpc-listen-port=6800
rpc-allow-origin-all=true
rpc-secret={{ atlas_aria2_rpc_secret.content | b64decode | trim }}
rpc-max-request-size=2M
enable-dht=false
enable-dht6=false
enable-peer-exchange=false
bt-enable-lpd=false
console-log-level=warn
