{% set in_container = workstation_git_in_devcontainer | default(false) %}
{% set git_support_dir = '/run/ecaas-git' if in_container else '~' %}
[init]
  defaultBranch = main

[core]
  excludesfile = {{ git_support_dir }}/.gitignore_global
  pager = delta

[user]
  name = {{ vault_personal_full_name }}
  email = {{ vault_git_work_email }}
  signingkey = {{ vault_git_work_gpg }}

[fetch]
  prune = true

[remote "origin"]
  prune = true

[pull]
  rebase = true

[commit]
  gpgsign = true

[merge]
  conflictstyle = diff3
  tool = {{ 'vscode' if in_container else 'bobide' }}

[mergetool]
  prompt = false

{% if in_container %}
[mergetool "vscode"]
  cmd = code --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"

[diff]
  tool = vscode

[difftool "vscode"]
  cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
{% else %}
[mergetool "bobide"]
  cmd = bobide --reuse-window --wait $MERGED

[diff]
  tool = bobide

[difftool "bobide"]
  cmd = bobide --reuse-window --wait --diff $LOCAL $REMOTE
{% endif %}

[color]
  ui = always

[color "status"]
  branch = magenta
  untracked = cyan
  unmerged = yellow bold

[color "diff"]
  frag = magenta bold
  old = red bold
  new = green bold
  whitespace = red reverse

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 52

[help]
  autocorrect = 30

[interactive]
  diffFilter = delta --color-only

[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  ld = log -p
  lg = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)%n' --all
  glog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
  onelinegraph = log --oneline --graph --decorate
  undo = reset --soft HEAD~1
  stash-all = stash save --include-untracked
  expireunreachablenow = reflog expire --expire-unreachable=now --all
  gcunreachablenow = gc --prune=now

[include]
  path = {{ git_support_dir }}/.themes.gitignore

[delta]
  features = catppuccin-mocha navigate
  true-color = always
  colorMoved = default
  tabs = 4
  side-by-side = true

{% for ca in workstation_git_container_cas | default(workstation_git_https_cas) %}
[http "{{ ca.url }}"]
{% if not in_container %}
  sslBackend = openssl
{% endif %}
  sslCAInfo = {{ '/run/ecaas-git-ca' if in_container else '~/.local/share/certs' }}/{{ ca.certificate }}

{% endfor %}
{% if not in_container %}
[credential]
  helper = store
{% endif %}

